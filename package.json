{
  "name": "ol-slmap",
  "version": "2.2.0",
  "private": true,
  "description": "A simple map viewer for Second Life using OpenLayers",
  "keywords": [
    "openlayers",
    "secondlife",
    "map"
  ],
  "homepage": "https://github.com/logue/ol-slmap",
  "bugs": {
    "url": "https://github.com/logue/ol-slmap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/logue/ol-slmap.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "rs dev --open",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rs lint . --fix",
    "lint:prettier": "rs fmt .",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "clean": "rimraf dist docs src-docs/public/demo",
    "clean:hard": "rimraf .rstack/cache .rstack/.rsdoctor demo dist docs node_modules/.tmp node_modules/.cache",
    "build": "rs build",
    "preview": "rs preview",
    "analyze": "cross-env RSDOCTOR=true rs lib",
    "version": "auto-changelog -p && git add CHANGELOG.md",
    "skills:install": "npx --no-install skills --version >/dev/null 2>&1 && npx skills experimental_install --yes || echo '\\033[1;33m⚠️  [Warning] skills command not found. Skipped auto-installation of agent skills.\\033[0m'",
    "skills:update": "npx skills update",
    "prepare": "rs hooks && pnpm run skills:install"
  },
  "dependencies": {
    "ol": "^10.11.0"
  },
  "devDependencies": {
    "@carbon/styles": "^1.119.0",
    "@carbon/type": "^11.71.0",
    "@carbon/web-components": "^2.67.0",
    "@playwright/test": "^1.65.1",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.1",
    "@rsdoctor/core": "^2.0.3",
    "@tsconfig/node-lts": "^26.0.1",
    "@types/node": "^26.6.6",
    "eslint-config-prettier": "^10.1.8",
    "npm-run-all2": "^9.0.4",
    "prettier-plugin-yaml": "^1.3.1",
    "rimraf": "^6.1.4",
    "rstack": "^0.9.1",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.18.0"
}
