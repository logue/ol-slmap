{
  "name": "ol-slmap",
  "version": "2.1.0",
  "private": true,
  "description": "A simple map viewer for Second Life using OpenLayers",
  "keywords": [
    "openlayers",
    "secondlife",
    "map"
  ],
  "homepage": "https://github.com/logue/ol-slmap",
  "bugs": {
    "url": "https://github.com/logue/ol-slmap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/logue/ol-slmap.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "rs dev",
    "lint": "run-s 'lint:*' --",
    "lint:rslint": "rs lint . --fix",
    "lint:prettier": "rs fmt .",
    "analyze": "RSDOCTOR=true rs build",
    "test": "rs test",
    "test:watch": "rs test --watch",
    "test:e2e": "playwright test",
    "clean": "rimraf demo dist docs",
    "clean:hard": "rimraf demo dist docs node_modules/.tmp node_modules/.cache",
    "build": "rs build",
    "preview": "rs preview",
    "prepare": "rs hooks",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.14.0",
    "ol": "^10.10.0"
  },
  "devDependencies": {
    "@eslint/markdown": "^8.0.3",
    "@playwright/test": "^1.63.0",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rsdoctor/rspack-plugin": "^1.6.4",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.6.3",
    "eslint-config-prettier": "^10.1.8",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "rstack": "^0.8.0",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.8.1"
}
