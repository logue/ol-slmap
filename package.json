{
  "name": "ol-slmap",
  "version": "2.0.2",
  "private": true,
  "description": "A simple map viewer for Second Life using OpenLayers",
  "keywords": [
    "openlayers",
    "secondlife",
    "map"
  ],
  "homepage": "https://github.com/logue/ol-slmap",
  "bugs": {
    "url": "https://github.com/logue/ol-slmap/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/logue/ol-slmap.git"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "dev": "rsbuild --open",
    "lint": "run-s 'lint:*' --",
    "lint:biome": "biome check --write",
    "lint:rslint": "rslint . --fix",
    "build": "rsbuild build",
    "preview": "rsbuild preview",
    "test": "rstest",
    "test:watch": "rstest --watch",
    "clean": "rimraf dist docs",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.cache",
    "version": "auto-changelog -p && git add CHANGELOG.md"
  },
  "dependencies": {
    "@awesome.me/webawesome": "^3.12.0",
    "ol": "^10.10.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@logue/biome-plugins": "^0.0.3",
    "@rsbuild/core": "^2.2.3",
    "@rsbuild/plugin-sass": "^2.0.1",
    "@rsbuild/plugin-type-check": "^1.6.0",
    "@rslint/core": "^0.9.2",
    "@tsconfig/node-lts": "^24.0.1",
    "@types/node": "^26.5.0",
    "npm-run-all2": "^9.0.3",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "packageManager": "pnpm@12.3.4"
}
