{
  "extends": "@tsconfig/node-lts/tsconfig.json",
  "include": [
    "env.d.ts",
    "src/**/*",
    "src-docs/**/*"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "lib": [
      "DOM"
    ],
    "types": [
      "@rsbuild/core/types",
      "node"
    ],
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.rsbuild.tsbuildinfo",
    "useDefineForClassFields": true,
    "outDir": "dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    /* modules */
    "module": "esnext",
    "isolatedModules": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    /* type checking */
    "noUnusedLocals": true,
    "noUnusedParameters": true
  }
}
